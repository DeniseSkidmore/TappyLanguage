classDiagram
    %% Language files (read-only, shipped). Proposal: one pack per language + one pair pack per language pair.
    direction LR

    namespace LanguagePack_one_per_language {
        class LanguagePack {
            languageCode : String
            version : String
        }
        class Word {
            id : String
            text : String
            length : Int
            frequencyRank : Int
        }
        class Phrase {
            id : String
            text : String
            wordIds : List~String~
        }
        class AudioClip {
            id : String
            sourceFile : String
            startMs : Int?
            endMs : Int?
            sourceRecordId : String
        }
        class SourceRecord {
            id : String
            sourceUrl : String
            author : String
            license : String
            retrieved : Date
        }
    }

    namespace PairPack_one_per_language_pair {
        class PairPack {
            learningLanguage : String
            knownLanguage : String
            version : String
        }
        class WordTranslation {
            learningWordId : String
            knownWordId : String
        }
        class PhraseTranslation {
            learningPhraseId : String
            knownPhraseId : String
        }
        class Phrasebook {
            name : String
            phraseIds : List~String~
            englishApproved : Boolean
        }
    }

    LanguagePack "1" *-- "many" Word
    LanguagePack "1" *-- "many" Phrase
    LanguagePack "1" *-- "many" AudioClip
    LanguagePack "1" *-- "many" SourceRecord
    Phrase "many" --> "many" Word : wordIds, ordered
    Word "1" --> "0..1" AudioClip : audio
    Phrase "1" --> "0..1" AudioClip : audio
    AudioClip "many" --> "1" SourceRecord : attribution

    PairPack "1" *-- "many" WordTranslation
    PairPack "1" *-- "many" PhraseTranslation
    PairPack "1" *-- "many" Phrasebook
    WordTranslation ..> Word : FK both sides
    PhraseTranslation ..> Phrase : FK both sides
    Phrasebook ..> Phrase : phraseIds
