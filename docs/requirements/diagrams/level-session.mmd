classDiagram
    %% In-process data for one level (memory only). Folded into Skill and ModeProgress (user-data.mmd) during the between-levels screen, then discarded.
    direction LR

    class Level {
        number : Int
        plannedPlays : Int
        targetSkills : List~SkillKey~
        distractorWordIds : List~String~
    }
    class SkillKey {
        itemType : ItemType
        itemId : String
        combination : Combination
    }
    class Play {
        prompt : SkillKey
        targetWordId : String
        success : Boolean
        latencyMs : Int
        wrongTapWordId : String?
    }
    class PhraseAttempt {
        phraseId : String
        hits : Int
        words : Int
        wrongTaps : Int
        score() Double
    }
    class LevelResult {
        successRate : Double
        improvedWordIds : List~String~
    }

    Level "1" *-- "many" Play
    Level "1" *-- "0..many" PhraseAttempt : sentence mode
    PhraseAttempt "1" o-- "many" Play
    Level "1" --> "1" LevelResult : between-levels screen
