{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read(./**)",
      "Edit(./docs/open-items.md)",
      "Write(./docs/open-items.md)",
      "Bash(git status*)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(bash .claude/hooks/py .claude/hooks/session_digest.py *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(*pip* install *)",
      "Bash(conda *)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(git rebase*)",
      "Bash(git filter-*)",
      "Bash(git reflog expire*)",
      "Bash(git gc*)"
    ],
    "deny": [
      "Bash(git push*--force*)",
      "Bash(git push* -f*)",
      "Bash(git push* +*)",
      "Edit(./.git/**)",
      "Write(./.git/**)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.keystore)",
      "Read(./**/*.jks)",
      "Read(./**/local.properties)",
      "Read(./**/google-services.json)",
      "Read(~/.ssh/**)",
      "Read(~/.android/**)",
      "Read(~/.git-credentials)",
      "Read(~/.gradle/gradle.properties)",
      "Read(./docs/notes/**)",
      "Bash(*.env*)",
      "Bash(*.keystore*)",
      "Bash(*.jks*)",
      "Bash(*.ssh*)",
      "Bash(*.android*)",
      "Bash(*gradle.properties*)",
      "Bash(*git-credentials*)",
      "Bash(*google-services.json*)",
      "PowerShell(*.env*)",
      "PowerShell(*.keystore*)",
      "PowerShell(*.jks*)",
      "PowerShell(*.ssh*)",
      "PowerShell(*.android*)",
      "PowerShell(*gradle.properties*)",
      "PowerShell(*git-credentials*)",
      "PowerShell(*google-services.json*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/docs/open-items.md\"; if [ -f \"$f\" ]; then echo '[SessionStart hook] Contents of docs/open-items.md (summarize in first reply per CLAUDE.md):'; cat \"$f\"; else echo '[SessionStart hook] docs/open-items.md not found'; fi"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/py\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_digest.py\" --hook --log \"$CLAUDE_PROJECT_DIR/.claude/metrics/sessions.jsonl\""
          }
        ]
      }
    ]
  }
}
